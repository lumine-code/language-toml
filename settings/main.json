{
  ".source.toml": {
    "editor": {
      "commentStart": "# ",
      "commentDelimiters": {
        "line": "#"
      },
      "nonWordCharacters": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?…"
    },
    "bracket-matcher": {
      "autocompleteCharacters": ["[]", "{}", "\"\"", "''"],
      "pairsWithExtraNewline": ["[]"]
    }
  }
}
